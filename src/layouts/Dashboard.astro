---
import "../styles/bootstrap.min.css";
import "../styles/bootstrap-icons/font/bootstrap-icons.min.css";

import Boton from "../components/Boton.astro";
import Hamburguesa from "../components/Hamburguesa.astro";

import Logonombre from "../components/Logonombre.astro";

interface Props {
  titulo: string;
  activo: string;
}

const { titulo, activo } = Astro.props;

const modulos = [
  { href: "/", label: "Inicio" },
  { href: "/recepcion", label: "Recepción" },
  { href: "/clientes", label: "Gestión de clientes" },
  { href: "/ordenes", label: "Lista de órdenes" },
  { href: "/facturacion", label: "Facturación" },
  { href: "/reparacion", label: "Proceso de reparación" },
  { href: "/admin", label: "Gestión de usuarios" },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Thec Service-{titulo}</title>
  </head>

  <body>
    <header class="bg-dark text-white fw-bolder">
      <div class="d-flex py-2 justify-content-between align-items-center">
        <div class="container-fluid ps-4 pe-0">
          <a class="navbar-brand ps-0" href="/">
            <img src="/src/img/logo2.jpg" alt="logo" height="35" width="55" class="me-2" />
            Tech Service
          </a>
        </div>

        <div class="col-6 col-sm-9 text-center p-0">
          <h2>{titulo}</h2>
        </div>
      </div>

      <div class="bg-light row py-2 px-3 justify-content-center border-bottom border-secondary">
        <Hamburguesa clases="d-md-none p-0 col-2 d-flex justify-content-center" clasesboton="p-0" clasesicono="bi-list fs-1" target="#dashboardmenu" />

        <form class="gap-1 d-flex align-items-center col-10" role="search">
          <input type="search" class="form-control" placeholder="Buscar Orden" aria-label="Campo para numero de orden" />
          <Boton texto={<i class="bi bi-search"></i>} tipo="submit" clases="" claseboton="btn-primary" href="#" aria-label="Boton para buscar" />
        </form>
      </div>
    </header>

    <div class="d-flex min-vh-100">
      <nav
        class="offcanvas-md offcanvas-start aria-labelledby px-3 pt-3 bg-dark text-white"

        id="dashboardmenu"
        style="width: 240px; min-height: 100vh;"
        tabindex="-1"
      >
        <ul class="nav flex-column gap-1">
          {modulos.map((m) => (
            <li class="nav-item">
              <a href={m.href} class={`nav-link ${m.href === activo ? "active bg-primary text-white rounded" : "text-white-50"}`}>
                {m.label}
              </a>
            </li>
          ))}
        </ul>
        <a href="/login" class="nav-link text-white-50 border-top border-secondary ps-3 pt-3 mt-3">
          Cerrar sesión
        </a>
      </nav>

      <main class="p-4 bg-light flex-grow-1">
        <slot />
      </main>
    </div>
    <script is:inline src="/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
