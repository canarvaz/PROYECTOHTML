---
import "../styles/bootstrap.min.css";
import "../styles/bootstrap-icons/font/bootstrap-icons.min.css";

import Boton from "../components/Boton.astro";
import Hamburguesa from "../components/Hamburguesa.astro";

import Logonombre from "../components/Logonombre.astro";

interface Props {
  titulo: string;
  activo: string;
}

const { titulo, activo } = Astro.props;

const modulos = [
  { href: "/", label: "Inicio" },
  { href: "/recepcion", label: "Recepción" },
  { href: "/clientes", label: "Gestión de clientes" },
  { href: "/ordenes", label: "Lista de órdenes" },
  { href: "/facturacion", label: "Facturación" },
  { href: "/reparacion", label: "Proceso de reparación" },
  { href: "/admin", label: "Gestión de usuarios" },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Thec Service-{titulo}</title>
    <style is:global>
      @media (min-width: 992px) {
        .table-compact-lg th,
        .table-compact-lg td {
          font-size: 0.85rem;
          padding: 0.45rem 0.6rem;
        }
      }
    </style>
  </head>

  <body>
    <div class="container-fluid row p-0 m-0 vh-100">
      <nav
        class="offcanvas-lg col-lg-2 offcanvas-start bg-dark text-white pt-3 ps-1 pe-1"
        id="dashboardmenu"
        aria-label="Menú principal"
        tabindex="-1"
      >
        <Logonombre />
        <ul class="nav flex-column gap-1 pt-3">
          {modulos.map((m) => (
            <li class="nav-item">
              <a href={m.href} class={`nav-link ${m.href === activo ? "active bg-primary text-white rounded" : "text-white-50"}`}>
                {m.label}
              </a>
            </li>
          ))}
        </ul>
        <a href="/login" class="nav-link text-white-50 border-top border-secondary ps-3 pt-3 mt-3">
          Cerrar sesión
        </a>
      </nav>

      <div class="col-lg-10 p-0">
        <header class="bg-dark row text-white fw-bolder m-0">
          <Hamburguesa
            clases="d-lg-none col-2 d-flex justify-content-center m-0 p-0 "
            clasesboton="p-0 m-auto"
            clasesicono="bi-list fs-1"
            target="#dashboardmenu"
          />

          <div class=" py-3 m-0 col-10 col-lg-12">
            <h2 class="text-center m-0">{titulo}</h2>
          </div>
        </header>

        <main class="px-2 bg-light flex-grow-1">
          <slot class="m-0" />
        </main>
      </div>
    </div>
    <script is:inline src="/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
