---
import Dashboard from "../layouts/Dashboard.astro";
import Tarjeta from "../components/Tarjeta.astro";
import Tabla from "../components/Tabla.astro";
import Columna from "../components/Columna.astro";

const columnas = ["Orden", "Cliente", "Dispositivo", "Progreso"];
const reparaciones = [
  [1, "Juan Pérez", "iPhone 12", "En diagnóstico"],
  [2, "María López", "Samsung S21", "En reparación"],
  [3, "Carlos Díaz", "MacBook Air", "Listo para entrega"],
];
---
<Dashboard titulo="Reparación" activo="/reparacion">
  <div class="row">
    <Columna>
      <Tarjeta titulo="Proceso de reparación" clasetitulo="text-center">
        <Tabla columnas={columnas} filas={reparaciones} />
      </Tarjeta>
    </Columna>
  </div>
</Dashboard>