---
import AppLayout from "../layouts/AppLayout.astro";
import Tarjeta from "../components/Tarjeta.astro";
import Tabla from "../components/Tabla.astro";
import Columna from "../components/Columna.astro";

const columnas = ["Servicio", "Cliente", "Estado"];

const sinCambios = [
  [1, 2, 3],
  [1, 2, 3],
];

const pendientes = [
  [1, 2, 3],
  [1, 2, 3],
];
---

<AppLayout titulo="Inicio" activo="/">
  <div class="row">
    <Columna>
      <Tarjeta titulo="Servicios" titulo="Tickets inactivos" clasetitulo="text-center">
        <Tabla columnas={columnas} filas={sinCambios} />
      </Tarjeta>
    </Columna>

    <Columna>
      <Tarjeta titulo="Servicios" titulo="Listos para entrega" clasetitulo="text-center">
        <Tabla columnas={columnas} filas={pendientes} />
      </Tarjeta>
    </Columna>
  </div>
</AppLayout>
