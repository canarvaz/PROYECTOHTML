---
import Dashboard from "../layouts/Dashboard.astro";
import Tarjeta from "../components/Tarjeta.astro";
import Tabla from "../components/Tabla.astro";
import Columna from "../components/Columna.astro";

const columnas = ["Ticket", "Cliente", "Estado", "Ultima nota", "Acciones"];

const sinCambios = [
  [1, "Juan Pérez", "Pendiente", "Se espera que cliente autorice la compra del teclado de repuesto", ""],
  [2, "María López", "Pendiente", "Aguardando confirmación de costo adicional", ""],
];

const pendientes = [
  [1, "Carlos Díaz", "Listo", "Reparación completada, listo para entrega", ""],
  [2, "Ana García", "Listo", "Diagnóstico finalizado", ""],
];
---

<Dashboard titulo="Inicio" activo="/">
  <div class="row pt-3">
    <Columna>
      <Tarjeta titulo="Servicios" titulo="Tickets inactivos" clasetitulo="h4-fluid text-center">
        <Tabla columnas={columnas} filas={sinCambios} />
      </Tarjeta>
    </Columna>

    <Columna>
      <Tarjeta titulo="Servicios" titulo="Listos para entrega" clasetitulo="text-center">
        <Tabla columnas={columnas} filas={pendientes} />
      </Tarjeta>
    </Columna>
  </div>
</Dashboard>