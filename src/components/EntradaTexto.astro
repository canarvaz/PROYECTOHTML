---
// src/components/EntradaTexto.astro
interface Props {
  id: string;
  label?: string;
  lineas?: number;
  placeholder?: string;
  requerido?: boolean;
  clases?: string;
}
const {
  id,
  label = "",
  lineas = 3,
  placeholder = "",
  requerido = true,
  clases = "",
} = Astro.props;
---

<div class={clases}>
  <label for={id} class="form-label fw-bold">
    {label}
  </label>
  <textarea
    class="form-control"
    id={id}
    rows={lineas}
    placeholder={placeholder}
    required={requerido}
  ></textarea>
</div>
