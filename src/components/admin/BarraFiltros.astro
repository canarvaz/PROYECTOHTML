---
// src/components/admin/BarraFiltros.astro
// Fila de filtros (selectores) + botón de nueva usuario.
import Selector from "../Selector.astro";

interface Props {
  roles?: string[];
  estados?: string[];
}

const {
  roles = ["Todos los roles", "Administrador", "Gestor", "Tecnico"],
  estados = ["Todos los estados", "Activo", "Inactivo"],
} = Astro.props;
---

<div class="row g-3 m-0 py-0  justify-content-between">
  <div class="col-md-3 m-0">
    <Selector id="rol" label="Rol" opciones={roles} clases="mb-0" />
  </div>
  <div class="col-md-3 m-0">
    <Selector id="estado" label="Estado" opciones={estados} clases="mb-0" />
  </div>
  <div class="col-md-3 m-0 d-flex align-items-end">
    <button class="btn btn-success w-100 d-flex align-items-center justify-content-center gap-2">
      <i class="bi bi-plus-lg"></i>
      Nuevo usuario
    </button>
  </div>
</div>
